# NutriAI Backend — Environment Variables
# Copy this file to .env and fill in your values

# Database — Neon Postgres (pooled connection string).
# Use the pooled host URL from the Neon dashboard and keep ?sslmode=require.
# If you use Neon's connection pooler (PgBouncer), also add &pgbouncer=true
# e.g. postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/nutriaidb?sslmode=require&pgbouncer=true
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/nutriaidb?sslmode=require&pgbouncer=true"

# Auth
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Server
PORT=5000
FRONTEND_URL=http://localhost:3000

# ML Microservice (FastAPI)
ML_SERVICE_URL=http://localhost:8000

# Groq AI (free tier) — used by /api/ml/chat, /api/ml/recipe-suggestions, /api/ml/nutrition-forecast
# Get a free key (no card) at https://console.groq.com/keys
GROQ_API_KEY=gsk_your-groq-api-key
# Optional: override the model (must be a Groq free-tier model)
GROQ_MODEL=openai/gpt-oss-120b

# Gemini AI — kept ONLY for food-photo vision (/api/ml/detect-food); Groq free tier has no vision model
GEMINI_API_KEY=your-gemini-api-key
